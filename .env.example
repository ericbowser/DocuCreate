# API server
API_PORT=8787
APP_URL=http://localhost:5173
APP_NAME=Docu Create
COMPANY_NAME=Execute & Engrave LLC
COMPANY_EMAIL=info@execute-engrave.com

# Frontend (Vite) — optional; dev proxies /api to API_PORT when unset
# VITE_API_URL=https://api.docu-create.com

# ── Production (docu-create.com) ──────────────────────────────
# NODE_ENV=production
# APP_URL=https://docu-create.com
# DOCUMENT_ENCRYPTION_KEY=   # required in production — openssl rand -hex 32
# Leave VITE_API_URL unset if /api is proxied on the same domain (recommended).
# VITE_API_URL=https://api.docu-create.com   # only if API is on a separate host

# Email — required for e-signature emails in production (mock mode in dev if unset)
# Put credentials in project root .env (src/.env is supported as fallback).
EMAIL_USER=you@example.com
EMAIL_RECEIVE=you@example.com
# Option A: Gmail app password
# EMAIL_APP_PASSWORD=
# Option B: Google OAuth (Gmail API / SMTP)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Document encryption at rest (generate: openssl rand -hex 32)
DOCUMENT_ENCRYPTION_KEY=

# Payments — disabled by default until you are ready to monetize.
# Leave PAYMENTS_ENABLED unset (or false) for free unlock at launch / indexing.
# PAYMENTS_ENABLED=true

# Stripe — required only when PAYMENTS_ENABLED=true
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
# STRIPE_CURRENCY=usd
# LEASE_PRICE_CENTS=1999

# Force free unlock even when PAYMENTS_ENABLED=true (emergency / local dev)
# PAYMENT_BYPASS=true
