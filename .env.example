# API server
API_PORT=24334

# ── PostgreSQL (docucreate schema) ────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/docucreate
# Run server/schema.sql once to create the docucreate schema and tables.

# Session secret — generate: openssl rand -hex 32
SESSION_SECRET=
APP_URL=http://localhost:24333
APP_NAME=Docu Create
COMPANY_NAME=Execute & Engrave LLC
COMPANY_EMAIL=info@execute-engrave.com

# Frontend (Vite) — optional; dev proxies /api to API_PORT when unset
# VITE_API_URL=https://api.docu-create.com

# ── Production (docu-create.com) ──────────────────────────────
# NODE_ENV=production
# APP_URL=https://docu-create.com
# DOCUMENT_ENCRYPTION_KEY=   # required in production — openssl rand -hex 32
# Leave VITE_API_URL unset if /api is proxied on the same domain (recommended).
# VITE_API_URL=https://api.docu-create.com   # only if API is on a separate host

# Email — required for e-signature emails in production (mock mode in dev if unset)
# Put credentials in project root .env (src/.env is supported as fallback).
EMAIL_USER=you@example.com
EMAIL_RECEIVE=you@example.com
# Option A: Gmail app password
# EMAIL_APP_PASSWORD=
# Option B: Google OAuth (Gmail API / SMTP)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Document encryption at rest (generate: openssl rand -hex 32)
DOCUMENT_ENCRYPTION_KEY=

# Payments — free unlock by default (leases are not locked).
# Stripe keys can stay in .env for later; documents stay unlocked until you set CHARGE_LEASES=true.
# PAYMENTS_ENABLED=true
# CHARGE_LEASES=true      # REQUIRED to actually gate leases / require payment before send
# PAYMENT_BYPASS=true     # optional override: force free unlock even if CHARGE_LEASES=true

# Stripe — required only when charging (PAYMENTS_ENABLED + CHARGE_LEASES)
# STRIPE_SECRET_KEY=sk_

# Tenant screening affiliate (wizard referral step)
# VITE_SCREENING_ENABLED=true
# VITE_SCREENING_PARTNER_NAME=RentPrep
# VITE_SCREENING_PARTNER_URL=https://www.rentprep.com