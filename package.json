{
  "name": "docucreate",
  "version": "1.0.0",
  "description": "Legal document creator - room rental leases with e-signature",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"vite\" \"node server/server.js\"",
    "dev:vite": "vite",
    "server": "node server/server.js",
    "dev:full": "npm run dev",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "npm run sitemap && vite build",
    "preview": "vite preview",
    "tail": "tailwindcss -i ./src/styles/index.css -o ./src/styles/output.css",
    "tail:watch": "tailwindcss -i ./src/styles/index.css -o ./src/styles/output.css --watch",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:lease": "cypress run --spec cypress/e2e/create-lease.cy.js",
    "cy:lease:headed": "cypress run --spec cypress/e2e/create-lease.cy.js --headed --browser chrome --config viewportWidth=1440,viewportHeight=900",
    "cy:lease:watch": "cypress run --spec cypress/e2e/create-lease.cy.js --headed --browser chrome --no-exit --config viewportWidth=1440,viewportHeight=900,video=false",
    "cy:e2e": "start-server-and-test dev http://localhost:24333 cy:lease"
  },
  "dependencies": {
    "@react-pdf/renderer": "^3.4.0",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-query-devtools": "^5.101.1",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-session": "^1.18.1",
    "nodemailer": "^9.0.1",
    "pg": "^8.11.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.0",
    "react-icons": "^5.6.0",
    "react-router-dom": "^6.22.0",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "babel-jest": "^30.4.1",
    "concurrently": "^8.2.2",
    "cypress": "^15.18.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.4.35",
    "start-server-and-test": "^3.0.11",
    "tailwindcss": "^3.4.1",
    "vite": "^8.0.16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericbowser/DocuCreate.git"
  },
  "author": "E.R.B.",
  "license": "ISC",
  "overrides": {
    "js-yaml": "^4.2.0"
  }
}
