{
  "name": "docucreate",
  "version": "1.0.0",
  "description": "Legal document creator - room rental leases with e-signature",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"vite\" \"node server/server.js\"",
    "dev:vite": "vite",
    "server": "node server/server.js",
    "dev:full": "npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "tail:watch": "tailwindcss -i ./src/index.css -o ./src/output.css --watch"
  },
  "dependencies": {
    "@react-pdf/renderer": "^3.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "nodemailer": "^6.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.0",
    "react-icons": "^5.6.0",
    "react-router-dom": "^6.22.0",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^8.0.16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericbowser/DocuCreate.git"
  },
