{
  "name": "docucreate",
  "version": "1.0.0",
  "description": "Legal document creator - room rental leases with e-signature",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"vite\" \"node server/server.js\"",
    "dev:vite": "vite",
    "server": "node server/server.js",
    "dev:full": "npm run dev",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "npm run sitemap && vite build",
    "preview": "vite preview",
    "tail": "tailwindcss -i ./src/styles/index.css -o ./src/styles/output.css",
    "tail:watch": "tailwindcss -i ./src/styles/index.css -o ./src/styles/output.css --watch"
  },
  "dependencies": {
    "@react-pdf/renderer": "^3.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "nodemailer": "^8.0.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.0",
    "react-icons": "^5.6.0",
    "react-router-dom": "^6.22.0",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "babel-jest": "^29.7.0",
    "concurrently": "^8.2.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^8.0.16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericbowser/DocuCreate.git"
  },
  "author": "E.R.B.",
  "license": "ISC"
}
